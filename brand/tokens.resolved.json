{
  "$schema": "./tokens-schema.md",
  "$comment": "shoota 视觉系统唯一参数源。暗色为主模式（平台只用暗色），亮色模式供品牌物料与浅底场景使用。派生文件由 visual-system 技能的生成器产出，不要手改。",
  "meta": {
    "app": "shoota",
    "source": "visual-system",
    "spec": "DTCG-1.0 + design-extract/profile-2",
    "tiers": [
      "primitive",
      "semantic",
      "component"
    ],
    "extensions": "com.design-extract",
    "modes": [
      "dark",
      "light"
    ],
    "defaultMode": "dark",
    "modeModel": "dark-primary",
    "themes": [],
    "medium": "desktop",
    "platform": "web",
    "units": {
      "base": 4,
      "spaceUnit": 4,
      "sizeBasis": 1,
      "remBase": 16,
      "timeUnit": "ms",
      "reference": "1 unit = 1 CSS px at 1x"
    },
    "defaults": {
      "scope": "derived",
      "scaling": "absolute",
      "confidence": "derived"
    },
    "languages": [
      "zh-CN",
      "en"
    ],
    "roles": {
      "text.primary": "semantic.color.text.primary",
      "text.secondary": "semantic.color.text.secondary",
      "text.tertiary": "semantic.color.text.tertiary",
      "surface.sunken": "semantic.color.surface.sunken",
      "surface.default": "semantic.color.surface.background",
      "surface.raised": "semantic.color.surface.raised",
      "surface.overlay": "semantic.color.surface.overlay",
      "accent": "semantic.color.action.primary",
      "onAccent": "semantic.color.text.onAction",
      "selection": "semantic.color.surface.selected",
      "divider": "semantic.color.border.subtle",
      "feedback.success": "semantic.color.feedback.success",
      "feedback.warning": "semantic.color.feedback.warning",
      "feedback.error": "semantic.color.feedback.error",
      "elevation.sunken": {
        "status": "notApplicable",
        "reason": "sunken wells (inputs, code boxes) are separated by fill only"
      },
      "elevation.default": {
        "status": "notApplicable",
        "reason": "the page ground casts no shadow"
      },
      "elevation.raised": "semantic.elevation.raised",
      "elevation.overlay": "semantic.elevation.overlay",
      "state.hover": "semantic.state.hover.opacity",
      "state.focus": "semantic.state.focus.opacity",
      "state.pressed": "semantic.state.pressed.opacity",
      "state.dragged": "semantic.state.dragged.opacity",
      "state.disabled": "semantic.state.disabled.opacity",
      "focusRing.width": "semantic.state.focus.ringWidth",
      "focusRing.offset": "semantic.state.focus.ringOffset",
      "focusRing.color": "semantic.state.focus.ring",
      "space.withinGroup": "semantic.space.withinGroup",
      "space.betweenGroups": "semantic.space.betweenGroups",
      "space.section": "semantic.space.section",
      "radius.pill": "semantic.radius.pill",
      "radius.innerMin": "semantic.radius.innerMin",
      "hairline": "semantic.layout.hairline"
    },
    "categories": {
      "typography": {
        "status": "present"
      },
      "fontWeight": {
        "status": "present"
      },
      "color": {
        "status": "present"
      },
      "space": {
        "status": "present"
      },
      "radius": {
        "status": "present"
      },
      "elevation": {
        "status": "present"
      },
      "state": {
        "status": "present"
      },
      "motion": {
        "status": "present"
      },
      "hairline": {
        "status": "present"
      },
      "typographyDisplay": {
        "status": "present"
      },
      "breakpoint": {
        "status": "present"
      },
      "zIndex": {
        "status": "present"
      },
      "material": {
        "status": "notApplicable",
        "reason": "no translucent surfaces; every layer is opaque, the game overlay covers the page"
      },
      "dataViz": {
        "status": "present"
      }
    },
    "notUsed": [
      {
        "id": "css-gradient",
        "note": "no CSS gradients on UI surfaces; cover art is canvas illustration and stays out of this rule",
        "css": {
          "valuePattern": "gradient\\("
        }
      },
      {
        "id": "text-shadow",
        "note": "no text shadow or glow; legibility over cover art comes from the art's own dark side",
        "css": {
          "property": "text-shadow"
        }
      },
      {
        "id": "backdrop-filter",
        "note": "no frosted glass; material is notApplicable",
        "css": {
          "property": "backdrop-filter"
        }
      },
      {
        "id": "serif-display",
        "note": "no serif display type in platform chrome; the rounded wordmark sets the voice"
      },
      {
        "id": "nested-cards",
        "note": "panels never nest more than one level"
      }
    ],
    "resolvedMode": "dark"
  },
